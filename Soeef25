local SavedClothes = {}

local function GetPlayerByShortName(shortName)
    shortName = shortName:lower()
    if shortName == "" or #shortName < 3 then return nil end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #shortName) == shortName or p.DisplayName:lower():sub(1, #shortName) == shortName then
            return p
        end
    end
    return nil
end

