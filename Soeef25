local function CreateTab(name, order)
    local TabBtn = Instance.new("TextButton", TabBar)
    TabBtn.Size = UDim2.new(1, 0, 0, 32)
    TabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    TabBtn.Text = "  " .. name
    TabBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.LayoutOrder = order
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
    
    local Page = Instance.new("ScrollingFrame", Container)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = (order == 1)
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = CurrentColor
    
    local PageLayout = Instance.new("UIListLayout", Page)
    PageLayout.Padding = UDim.new(0, 6)
    
    PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
    end)
    
    if order == 1 then 
        TabBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 45) 
        TabBtn.TextColor3 = IsRainbow and Color3.fromRGB(255,255,255) or CurrentColor
        TabBtn.Name = "ActiveTab"
    else
        TabBtn.Name = "NormalTab"
    end
    
    TabBtn.MouseButton1Click:Connect(function()
        ClickSound:Play()
        for _, p in pairs(pages) do p.Visible = false end
        for _, b in pairs(tabButtons) do 
            b.BackgroundColor3 = Color3.fromRGB(25, 25, 30) 
            b.TextColor3 = Color3.fromRGB(150, 150, 160)
            b.Name = "NormalTab"
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
        TabBtn.TextColor3 = IsRainbow and Color3.fromRGB(255,255,255) or CurrentColor
        TabBtn.Name = "ActiveTab"
    end)
    
    pages[name] = Page
    table.insert(tabButtons, TabBtn)
    return Page
end

