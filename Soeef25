RunService.RenderStepped:Connect(function()
    local loudness = VisSound.PlaybackLoudness or 0
    local intensity = math.clamp(loudness / 250, 0, 1)

    for _, data in ipairs(Bars) do
        local wave = math.sin(tick() * 4 + data.Index)
        local targetHeight = 8 + (intensity * 60) + (intensity * wave * 20)
        TweenService:Create(data.Frame, TweenInfo.new(0.08, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 4, 0, math.clamp(targetHeight, 8, 80))}):Play()
        
        if IsRainbow then 
            data.Frame.BackgroundColor3 = Color3.fromHSV(tick() % 5 / 5, 0.8, 1) 
        end
    end
    
    -- ==================== [ تحديث وتوليد الجزيئات العائمة - الفكرة 5 ] ====================
    if MainFrame.Visible and #LiveParticles < 18 and math.random() < (0.04 + intensity * 0.12) then
        local p = Instance.new("Frame", ParticleContainer)
        local size = math.random(2, 4)
        p.Size = UDim2.new(0, size, 0, size)
        p.Position = UDim2.new(math.random(), 0, 1, 0)
        p.BackgroundTransparency = 0.4
        p.BackgroundColor3 = IsRainbow and Color3.fromHSV(tick() % 5 / 5, 0.8, 1) or CurrentColor
        p.BorderSizePixel = 0
        p.ZIndex = 0
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
        
        table.insert(LiveParticles, {
            Frame = p,
            Speed = math.random(15, 45) / 10000, 
            XMove = (math.random() - 0.5) * 0.003
        })
    end

    for idx = #LiveParticles, 1, -1 do
        local pData = LiveParticles[idx]
        local frame = pData.Frame
        if frame and frame.Parent then
            local currentSpeed = pData.Speed * (1 + intensity * 3.5)
            frame.Position = UDim2.new(frame.Position.X.Scale + pData.XMove, 0, frame.Position.Y.Scale - currentSpeed, 0)
            
            if IsRainbow then
                frame.BackgroundColor3 = Color3.fromHSV(tick() % 5 / 5, 0.8, 1)
            else
                frame.BackgroundColor3 = CurrentColor
            end
            
            if frame.Position.Y.Scale < 0.4 then
                frame.BackgroundTransparency = 0.4 + (1 - (frame.Position.Y.Scale / 0.4)) * 0.6
            end
            
            if frame.Position.Y.Scale < -0.05 or frame.Position.X.Scale < -0.1 or frame.Position.X.Scale > 1.1 then
                frame:Destroy()
                table.remove(LiveParticles, idx)
            end
        else
            table.remove(LiveParticles, idx)
        end
    end
    -- ====================================================================================
    
    if IsRainbow then
        local rc = Color3.fromHSV(tick() % 5 / 5, 1, 1)
        MainStroke.Color = rc
        Title.TextColor3 = rc
        OpenStroke.Color = rc
        for _, b in pairs(tabButtons) do
            if b.Name == "ActiveTab" then b.TextColor3 = rc end
        end
        BGGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(15, 15, 18)),
            ColorSequenceKeypoint.new(1, rc:Lerp(Color3.fromRGB(15, 15, 18), 0.7))
        })
    else
        local pulseColor = CurrentColor:Lerp(Color3.fromRGB(15, 15, 18), 1 - (intensity * 0.8))
        BGGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(15, 15, 18)),
            ColorSequenceKeypoint.new(1, pulseColor)
        })
        BGGradient.Rotation = 45 + (intensity * 15)
    end
    
    if intensity > 0.4 then
        MainStroke.Thickness = 1.5 + ((intensity - 0.4) * 2.5)
    else
        MainStroke.Thickness = 1.5
    end
end)

