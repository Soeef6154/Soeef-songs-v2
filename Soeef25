local function ShowNotification(text, imageId)
    local NotifFrame = Instance.new("Frame", ScreenGui)
    NotifFrame.Size = UDim2.new(0, 240, 0, 45)
    NotifFrame.Position = UDim2.new(0.5, -120, 0, -60)
    NotifFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
    NotifFrame.BorderSizePixel = 0
    NotifFrame.ZIndex = 100
    
    Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 8)
    
    local NotifStroke = Instance.new("UIStroke", NotifFrame)
    NotifStroke.Color = CurrentColor
    NotifStroke.Thickness = 1.5
    
    local NotifImage = Instance.new("ImageLabel", NotifFrame)
    NotifImage.Size = UDim2.new(0, 25, 0, 25)
    NotifImage.Position = UDim2.new(1, -35, 0.5, -12.5)
    NotifImage.BackgroundTransparency = 1
    NotifImage.Image = "rbxassetid://" .. tostring(imageId or "73803211578344")
    NotifImage.ZIndex = 101
    
    local NotifText = Instance.new("TextLabel", NotifFrame)
    NotifText.Size = UDim2.new(1, -50, 1, 0)
    NotifText.Position = UDim2.new(0, 10, 0, 0)
    NotifText.BackgroundTransparency = 1
    NotifText.Text = text
    NotifText.TextColor3 = Color3.fromRGB(240, 240, 245)
    NotifText.Font = Enum.Font.GothamBold
    NotifText.TextSize = 12
    NotifText.TextXAlignment = Enum.TextXAlignment.Right
    NotifText.ZIndex = 101

    TweenService:Create(NotifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -120, 0, 20)}):Play()
    
    task.delay(3, function()
        local hideTween = TweenService:Create(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -120, 0, -60)})
        hideTween:Play()
        hideTween.Completed:Wait()
        NotifFrame:Destroy()
    end)
end

