local BAN_FILE = "SoeefHub_Bans.json"
pcall(function()
    if isfile and isfile(BAN_FILE) then
        local bans = HttpService:JSONDecode(readfile(BAN_FILE))
        if bans[LocalPlayer.Name] then
            local unbanTime = bans[LocalPlayer.Name]
            if os.time() < unbanTime then
                local remaining = unbanTime - os.time()
                local msg = "⛔ تم حظرك من استخدام Soeef Hub بواسطة المطور سويف!"
                if remaining > 31536000 then 
                    msg = msg .. "\nنوع الحظر: نهائي 🔨"
                else
                    msg = msg .. "\nالوقت المتبقي لفك الحظر: " .. math.ceil(remaining / 60) .. " دقيقة."
                end
                LocalPlayer:Kick(msg)
                task.wait(9e9) -- إيقاف السكربت تماماً
                return
            else
                -- انتهت مدة الحظر (تنظيف الملف)
                bans[LocalPlayer.Name] = nil
                if writefile then writefile(BAN_FILE, HttpService:JSONEncode(bans)) end
            end
        end
    end
end)
